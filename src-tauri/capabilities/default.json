{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CCL main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "store:default",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    "ccl-android:allow-check-storage-permission",
    "ccl-android:allow-request-storage-permission"
  ]
}
